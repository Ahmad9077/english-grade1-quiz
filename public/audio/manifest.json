      "durationMs": 2123,
      "bytes": 17597
    },
    "ar/ui/streak-5-1": {
      "text": "خمسة صح ورا بعض! ما في أحلى!",
      "hash": "8f86cd274cb81bf2",
      "durationMs": 2996,
      "bytes": 24493
    },
    "ar/ui/streak-5-2": {
      "text": "خمسة على طول! شي يفرح.",
      "hash": "27a810dcfe921b26",
      "durationMs": 2685,
      "bytes": 21985
    },
    "ar/ui/test-intro-1": {
      "text": "اختبار تجريبي مثل ورقة الاختبار. نبدأ بالقراءة، وبعدها الكتابة. يلا!",
      "hash": "624aa5ec4dcfc746",
      "durationMs": 6458,
      "bytes": 52287
    },
    "ar/ui/test-intro-2": {
      "text": "جاهزين؟ عشرة أسئلة مثل الاختبار بالضبط. أول شي القراءة.",
      "hash": "438dda5d4ea2de73",
      "durationMs": 5997,
      "bytes": 48526
    },
    "ar/ui/to-writing-1": {
      "text": "خلصنا القراءة! الحين جزء الكتابة.",
      "hash": "86aff215be7bd1b1",
      "durationMs": 3312,
      "bytes": 27001
    },
    "ar/ui/to-writing-2": {
      "text": "القراءة خلصت، الحين نكتب!",
      "hash": "2d6dd2e8f8fb59ea",
      "durationMs": 2714,
      "bytes": 22194
    },
    "ar/ui/top-first-1": {
      "text": "نختار من فوق أول، وبعدين من تحت.",
      "hash": "4199f337fb67b551",
      "durationMs": 3229,
      "bytes": 26374
    },
    "ar/ui/trace-again-1": {
      "text": "نكتب فوق الكتابة الرمادية بالضبط، ونحاول مرة ثانية.",
      "hash": "c940f38e77a9ae0e",
      "durationMs": 4211,
      "bytes": 34315
    },
    "ar/ui/trace-again-2": {
      "text": "باقي شوي! نمشي على الرمادي بالضبط.",
      "hash": "ad0735bed2030a0f",
      "durationMs": 3379,
      "bytes": 27628
    },
    "ar/ui/welcome-1": {
      "text": "أهلين! جاهزين للإنجليزي؟ نختار درس ونبدأ.",
      "hash": "e2b4fb967b5a998c",
      "durationMs": 4272,
      "bytes": 34733
    },
    "ar/ui/welcome-2": {
      "text": "يا هلا! الحروف والكلمات تنطرنا. من وين نبدأ؟",
      "hash": "bd4d973752f865e4",
      "durationMs": 4396,
      "bytes": 35778
    },
    "ar/ui/welcome-3": {
      "text": "مرحبا! يلا نتدرب على الإنجليزي، نختار درس.",
      "hash": "ce524571cd84c52e",
      "durationMs": 4172,
      "bytes": 33897
    },
    "ar/ui/x-big-1": {
      "text": "حرفه الكبير هو",
      "hash": "56fde8e48edae84a",
      "durationMs": 1885,
      "bytes": 15716
    },
    "ar/ui/x-count-1": {
      "text": "نعدها مع بعض",
      "hash": "82264e919a609866",
      "durationMs": 1220,
      "bytes": 10283
    },
    "ar/ui/x-count-2": {
      "text": "نعد على مهل",
      "hash": "a3cb7d00eb098865",
      "durationMs": 1457,
      "bytes": 12163
    },
    "ar/ui/x-find-1": {
      "text": "نعد الصورة الصح مع بعض",
      "hash": "b8000016da7628b5",
      "durationMs": 2115,
      "bytes": 17388
    },
    "ar/ui/x-missing-1": {
      "text": "تبدأ بحرف",
      "hash": "80728760b8f6b3b2",
      "durationMs": 1373,
      "bytes": 11536
    },
    "ar/ui/x-missing-2": {
      "text": "أول حرف فيها",
      "hash": "f76964eecc319a16",
      "durationMs": 1484,
      "bytes": 12372
    },
    "ar/ui/x-pic-1": {
      "text": "الصورة اللي تبدأ فيه هي",
      "hash": "9f1cb18e6840471e",
      "durationMs": 2118,
      "bytes": 17597
    },
    "ar/ui/x-pic-2": {
      "text": "هالحرف يبدأ فيه اسم",
      "hash": "04c3196a2d60da72",
      "durationMs": 2248,
      "bytes": 18642
    },
    "ar/ui/x-small-1": {
      "text": "حرفه الصغير هو",
      "hash": "673770981ae2b3b9",
      "durationMs": 1908,
      "bytes": 15925
    },
    "ar/ui/x-word-1": {
      "text": "هذي الصورة اسمها",
      "hash": "e6fa626a461db9cb",
      "durationMs": 1800,
      "bytes": 14880
    },
    "ar/ui/x-word-2": {
      "text": "اسمها بالإنجليزي",
      "hash": "74b67830b61620e9",
      "durationMs": 1484,
      "bytes": 12372
    },
